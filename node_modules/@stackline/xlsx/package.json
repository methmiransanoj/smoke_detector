{
	"name": "@stackline/xlsx",
	"version": "1.0.9",
	"author": "sheetjs",
	"description": "SheetJS-compatible spreadsheet parser and writer with Stackline security hardening",
	"keywords": [
		"stackline",
		"sheetjs",
		"excel",
		"spreadsheet",
		"csv",
		"xlsx",
		"xls",
		"xlsb",
		"xlsm",
		"ods",
		"dbf",
		"dif",
		"sylk",
		"excel-parser",
		"excel-writer",
		"typescript",
		"javascript",
		"nodejs",
		"browser"
	],
	"main": "xlsx.js",
	"module": "xlsx.mjs",
	"unpkg": "dist/xlsx.full.min.js",
	"jsdelivr": "dist/xlsx.full.min.js",
	"types": "types/index.d.ts",
	"exports": {
		".": {
			"types": "./types/index.d.ts",
			"import": "./xlsx.mjs",
			"require": "./xlsx.js"
		},
		"./xlsx.mjs": {
			"types": "./types/index.d.ts",
			"import": "./xlsx.mjs"
		},
		"./xlsx.js": {
			"types": "./types/index.d.ts",
			"require": "./xlsx.js"
		},
		"./dist/xlsx.core.min": {
			"types": "./types/index.d.ts",
			"import": "./dist/xlsx.core.min.js",
			"require": "./dist/xlsx.core.min.js"
		},
		"./dist/xlsx.core.min.js": {
			"types": "./types/index.d.ts",
			"import": "./dist/xlsx.core.min.js",
			"require": "./dist/xlsx.core.min.js"
		},
		"./dist/xlsx.full.min": {
			"types": "./types/index.d.ts",
			"import": "./dist/xlsx.full.min.js",
			"require": "./dist/xlsx.full.min.js"
		},
		"./dist/xlsx.full.min.js": {
			"types": "./types/index.d.ts",
			"import": "./dist/xlsx.full.min.js",
			"require": "./dist/xlsx.full.min.js"
		},
		"./dist/xlsx.mini.min": {
			"types": "./types/index.d.ts",
			"import": "./dist/xlsx.mini.min.js",
			"require": "./dist/xlsx.mini.min.js"
		},
		"./dist/xlsx.mini.min.js": {
			"types": "./types/index.d.ts",
			"import": "./dist/xlsx.mini.min.js",
			"require": "./dist/xlsx.mini.min.js"
		},
		"./dist/xlsx.zahl": {
			"types": "./dist/zahl.d.ts",
			"import": "./dist/xlsx.zahl.mjs",
			"require": "./dist/xlsx.zahl.js"
		},
		"./dist/xlsx.zahl.mjs": {
			"types": "./dist/zahl.d.ts",
			"import": "./dist/xlsx.zahl.mjs"
		},
		"./dist/xlsx.zahl.js": {
			"types": "./dist/zahl.d.ts",
			"require": "./dist/xlsx.zahl.js"
		},
		"./dist/cpexcel": {
			"types": "./dist/cpexcel.d.ts",
			"import": "./dist/cpexcel.full.mjs",
			"require": "./dist/cpexcel.js"
		},
		"./dist/cpexcel.js": {
			"types": "./dist/cpexcel.d.ts",
			"require": "./dist/cpexcel.js"
		},
		"./dist/cpexcel.full": {
			"types": "./dist/cpexcel.d.ts",
			"import": "./dist/cpexcel.full.mjs",
			"require": "./dist/cpexcel.js"
		},
		"./dist/cpexcel.full.mjs": {
			"types": "./dist/cpexcel.d.ts",
			"import": "./dist/cpexcel.full.mjs"
		}
	},
	"browser": {
		"buffer": false,
		"crypto": false,
		"stream": false,
		"process": false,
		"fs": false
	},
	"sideEffects": false,
	"devDependencies": {
		"@stackline/adler-32": "1.0.0",
		"@stackline/alex": "1.0.0",
		"@stackline/blanket": "1.0.0",
		"@stackline/cfb": "1.0.0",
		"@stackline/codepage": "1.0.0",
		"@stackline/crc-32": "1.0.0",
		"@stackline/exit-on-epipe": "1.0.0",
		"@stackline/ssf": "1.0.0",
		"@stackline/uglify-js": "1.0.0",
		"@stackline/wmf": "1.0.0",
		"@types/node": "^8.5.9",
		"acorn": "^8.17.0",
		"commander": "~2.17.1",
		"eslint": "^10.5.0",
		"eslint-plugin-html": "^8.1.4",
		"fflate": "^0.8.3",
		"jsdom": "^29.1.1",
		"mocha": "12.0.2",
		"typescript": "^5.9.3"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/alexandroit/sheetjs.git"
	},
	"scripts": {
		"pretest": "npm run lint && npm run metrics:test && npm run package:contract && npm run maintenance:test",
		"test": "npm run tests-only",
		"pretest-only": "git submodule init && git submodule update",
		"tests-only": "make travis",
		"build": "make",
		"lint": "make fullint",
		"dtslint": "tsc -p types/tsconfig.json",
		"types-compat": "bash misc/typescript-compat.sh",
		"metrics:test": "node --test misc/npm-version-downloads.test.mjs",
		"metrics:collect": "node misc/npm-version-downloads.mjs",
		"package:contract": "node --test misc/package-contract.test.mjs",
		"maintenance:test": "node --test misc/scoped-dependency-regressions.test.mjs misc/sheet-filter-regression.test.mjs misc/numbers-negative-regression.test.mjs misc/wk3-negative-regression.test.mjs"
	},
	"config": {
		"blanket": {
			"pattern": "xlsx.js"
		}
	},
	"alex": {
		"allow": [
			"chinese",
			"special",
			"simple",
			"just",
			"crash",
			"wtf",
			"holes"
		]
	},
	"homepage": "https://alexandro.net/docs/vanilla/xlsx/",
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org"
	},
	"files": [
		"CHANGELOG.md",
		"CONTRIBUTING.md",
		"LICENSE",
		"NOTICE",
		"README.md",
		"SECURITY.md",
		"bower.json",
		"package.json",
		"xlsx.js",
		"xlsx.mjs",
		"xlsxworker.js",
		"dist/LICENSE",
		"dist/*.mjs",
		"dist/*.js",
		"dist/*.map",
		"dist/*.d.ts",
		"types/index.d.ts",
		"types/tsconfig.json"
	],
	"bugs": {
		"url": "https://github.com/alexandroit/sheetjs/issues"
	},
	"license": "Apache-2.0",
	"engines": {
		"node": ">=20"
	},
	"directories": {
		"test": "tests"
	}
}
